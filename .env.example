# --- Application -----------------------------------------------------------
WEALTHY_APP_NAME="Wealthy Property Portfolio Engine"
WEALTHY_APP_VERSION="7.1.0"
# True enables tracebacks, /docs, /redoc and /openapi.json. Dev only.
WEALTHY_DEBUG=true

# --- Database --------------------------------------------------------------
# Alembic owns the schema. `alembic upgrade head` before starting the app.
WEALTHY_DATABASE_URL="postgresql+psycopg://wealthnexus:wealthnexus_dev@localhost:5432/wealthnexus_db"
# Dev convenience only — `create_all()` can never ALTER an existing schema.
WEALTHY_AUTO_CREATE_TABLES=false

# --- Domain.com.au valuation provider --------------------------------------
# API key from https://developer.domain.com.au — looks like "key_...".
# Sent as the `x-api-key` header. Leave blank to serve labelled estimates.
WEALTHY_DOMAIN_API_KEY=
# "api_key" (x-api-key header) or "bearer" (Authorization: Bearer).
WEALTHY_DOMAIN_AUTH_MODE=api_key
WEALTHY_DOMAIN_BASE_URL="https://api.domain.com.au"
WEALTHY_DOMAIN_TIMEOUT=10
WEALTHY_DOMAIN_CONNECT_TIMEOUT=3.05
WEALTHY_DOMAIN_RETRIES=2

# --- Provider failure behaviour --------------------------------------------
# Degrade to an algorithmic estimate (labelled as such) when Domain is down.
WEALTHY_ALLOW_ESTIMATE_FALLBACK=true
# Return 502 instead of degrading. Also makes a missing API key a startup error.
WEALTHY_STRICT_PROVIDER=false

# --- Transport -------------------------------------------------------------
# Explicit origins — never "*" while sending credentials.
WEALTHY_CORS_ORIGINS=["http://localhost:5173"]
